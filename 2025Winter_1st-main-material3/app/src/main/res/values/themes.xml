<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Molip_1st" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Material Design 3 색상 시스템 적용 -->
        
        <!-- Primary 색상 -->
        <item name="colorPrimary">@color/md3_color_primary</item>
        <item name="colorOnPrimary">@color/md3_color_on_primary</item>
        <item name="colorPrimaryContainer">@color/md3_color_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md3_color_on_primary_container</item>
        
        <!-- Secondary 색상 -->
        <item name="colorSecondary">@color/md3_color_secondary</item>
        <item name="colorOnSecondary">@color/md3_color_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md3_color_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md3_color_on_secondary_container</item>
        
        <!-- Tertiary 색상 -->
        <item name="colorTertiary">@color/md3_color_tertiary</item>
        <item name="colorOnTertiary">@color/md3_color_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md3_color_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md3_color_on_tertiary_container</item>
        
        <!-- Error 색상 -->
        <item name="colorError">@color/md3_color_error</item>
        <item name="colorOnError">@color/md3_color_on_error</item>
        <item name="colorErrorContainer">@color/md3_color_error_container</item>
        <item name="colorOnErrorContainer">@color/md3_color_on_error_container</item>
        
        <!-- Surface 색상 -->
        <item name="colorSurface">@color/md3_color_surface</item>
        <item name="colorOnSurface">@color/md3_color_on_surface</item>
        <item name="colorSurfaceVariant">@color/md3_color_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md3_color_on_surface_variant</item>
        <item name="colorSurfaceInverse">@color/md3_color_surface_inverse</item>
        <item name="colorOnSurfaceInverse">@color/md3_color_on_surface_inverse</item>
        
        <!-- Outline 색상 -->
        <item name="colorOutline">@color/md3_color_outline</item>
        <item name="colorOutlineVariant">@color/md3_color_outline_variant</item>
        
        <!-- Background 색상 -->
        <item name="android:colorBackground">@color/md3_color_background</item>
        <item name="colorOnBackground">@color/md3_color_on_background</item>
        
        <!-- Typography 시스템 적용 (Material3는 android: 접두사 없이 사용) -->
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.Molip_1st.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.Molip_1st.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.Molip_1st.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Molip_1st.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Molip_1st.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Molip_1st.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Molip_1st.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Molip_1st.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Molip_1st.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Molip_1st.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Molip_1st.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Molip_1st.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Molip_1st.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Molip_1st.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Molip_1st.LabelSmall</item>
        
        <!-- Shape 시스템 적용 (Material3는 테마 속성으로 직접 설정하지 않음, 각 컴포넌트에서 직접 참조) -->
    </style>

    <style name="Theme.Molip_1st" parent="Base.Theme.Molip_1st" />
</resources>